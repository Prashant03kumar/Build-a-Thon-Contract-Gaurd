{
  "name": "contract-guard-server",
  "version": "0.2.0",
  "private": true,
  "description": "Contract Guard API — Express + TypeScript + Prisma/SQLite",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:smoke": "tsx prisma/smoke.ts",
    "test": "tsx src/engine/engine.test.ts",
    "test:m3": "tsx src/m3.test.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@prisma/client": "^6.7.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
